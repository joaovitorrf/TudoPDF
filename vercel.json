{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://apis.google.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.googletagmanager.com https://ep2.adtrafficquality.google; script-src-elem 'self' 'unsafe-inline' https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://apis.google.com https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.googletagmanager.com https://ep2.adtrafficquality.google; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' blob: data: https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.googleapis.com https://firebaseinstallations.googleapis.com https://www.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://pagead2.googlesyndication.com https://ep1.adtrafficquality.google; frame-src 'self' https://tudo-pdf.firebaseapp.com https://accounts.google.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/planos", "destination": "/precos/", "permanent": true },
    { "source": "/download", "destination": "/baixar/", "permanent": true },
    { "source": "/downloads", "destination": "/baixar/", "permanent": true },
    { "source": "/app", "destination": "/baixar/", "permanent": true },
    { "source": "/imagem", "destination": "/imagens/", "permanent": true },
    { "source": "/entrar", "destination": "/login/", "permanent": true },
    { "source": "/cadastro", "destination": "/login/?novo=1", "permanent": true },
    { "source": "/minha-conta", "destination": "/conta/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/tools/:tool", "destination": "/tools/:tool/index.html" },
    { "source": "/tools/:tool/", "destination": "/tools/:tool/index.html" },
    { "source": "/blog/:post", "destination": "/blog/:post/index.html" },
    { "source": "/blog/:post/", "destination": "/blog/:post/index.html" },
    { "source": "/login", "destination": "/login/index.html" },
    { "source": "/login/", "destination": "/login/index.html" },
    { "source": "/conta", "destination": "/conta/index.html" },
    { "source": "/conta/", "destination": "/conta/index.html" },
    { "source": "/vip", "destination": "/vip/index.html" },
    { "source": "/vip/", "destination": "/vip/index.html" },
    { "source": "/imagens", "destination": "/imagens/index.html" },
    { "source": "/imagens/", "destination": "/imagens/index.html" },
    { "source": "/baixar", "destination": "/baixar/index.html" },
    { "source": "/baixar/", "destination": "/baixar/index.html" },
    { "source": "/sobre", "destination": "/sobre/index.html" },
    { "source": "/sobre/", "destination": "/sobre/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/faq/", "destination": "/faq/index.html" },
    { "source": "/como-funciona", "destination": "/como-funciona/index.html" },
    { "source": "/como-funciona/", "destination": "/como-funciona/index.html" },
    { "source": "/contato", "destination": "/contato/index.html" },
    { "source": "/contato/", "destination": "/contato/index.html" },
    { "source": "/privacidade", "destination": "/privacidade/index.html" },
    { "source": "/privacidade/", "destination": "/privacidade/index.html" },
    { "source": "/termos", "destination": "/termos/index.html" },
    { "source": "/termos/", "destination": "/termos/index.html" },
    { "source": "/cookies", "destination": "/cookies/index.html" },
    { "source": "/cookies/", "destination": "/cookies/index.html" },
    { "source": "/ferramentas", "destination": "/ferramentas/index.html" },
    { "source": "/ferramentas/", "destination": "/ferramentas/index.html" },
    { "source": "/empresarial", "destination": "/empresarial/index.html" },
    { "source": "/empresarial/", "destination": "/empresarial/index.html" },
    { "source": "/ensino", "destination": "/ensino/index.html" },
    { "source": "/ensino/", "destination": "/ensino/index.html" },
    { "source": "/legal-juridico", "destination": "/legal-juridico/index.html" },
    { "source": "/legal-juridico/", "destination": "/legal-juridico/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/", "destination": "/blog/index.html" },
    { "source": "/caracteristicas", "destination": "/caracteristicas/index.html" },
    { "source": "/caracteristicas/", "destination": "/caracteristicas/index.html" },
    { "source": "/precos", "destination": "/precos/index.html" },
    { "source": "/precos/", "destination": "/precos/index.html" },
    { "source": "/seguranca", "destination": "/seguranca/index.html" },
    { "source": "/seguranca/", "destination": "/seguranca/index.html" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404/index.html", "status": 404 }
  ]
}
